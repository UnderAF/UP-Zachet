<Window x:Class="Testik.Views.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Testik.Views"
        mc:Ignorable="d"
        Title="GuestWindow" Height="450" Width="800">
    <Grid>
        <ScrollViewer Margin="0">
            <ItemsControl>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2" CornerRadius="2" BorderBrush="Black" BorderThickness="1">
                            <DockPanel>
                                <Image Source="{Binding PhotoNewName}" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Price}" DockPanel.Dock="Right" FontSize="16.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}"/>
                                        <TextBlock Text=" / "/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"/>
                                    <TextBlock Text="{Binding Compound}"/>
                                    <TextBlock Text="{Binding Weight}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
