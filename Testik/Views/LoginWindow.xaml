<Window x:Class="Testik.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Testik"
        mc:Ignorable="d"
        Icon="/Images/Icon.ico"
        WindowStartupLocation="CenterScreen"
        Title="LoginWindow" Height="550" Width="550" MinHeight="400" MinWidth="300">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Images/Icon.png" Width="120" Height="120" Margin="10 0 10 25"/>
            <TextBlock Text="Введите логин" TextAlignment="Left" FontSize="12.5" Margin="0 2 0 0"/>
            <TextBox x:Name="LoginInput" Text="wolfik" FontSize="13" Margin="0 2 0 0"/>
            <TextBlock Text="Введите пароль" TextAlignment="Left" FontSize="12.5" Margin="0 15 0 0"/>
            <TextBox x:Name="PasswordInput" Text="jg4543F" FontSize="13" Margin="0 2 0 0"/>
            <Button Content="Войти" FontSize="14" Margin="0 25 0 0" Click="Button_Click"/>
            <TextBlock Text="Или" TextAlignment="Center" FontSize="12" Margin="0 8 0 8"/>
            <Button Content="Войти как гость" FontSize="14" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
